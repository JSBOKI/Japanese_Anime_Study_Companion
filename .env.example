PORT=3000
HOST=0.0.0.0
# Persistent folder for the SQLite database, dictionary cache, and generated MP3s.
DATA_DIR=./data

# Leave blank for open local use. Set a long password before the server is on the internet.
# The sign-in cookie lasts 180 days. It is marked Secure when the request arrives over HTTPS
# (including behind a proxy that sets X-Forwarded-Proto).
APP_PASSWORD=
# COOKIE_SECURE=true forces the Secure flag even if the proxy header is missing.
# COOKIE_SECURE=false keeps the cookie working on plain HTTP.

# Lessons work without an LLM. Set a provider only if you want natural line translations
# and a short extra note on each grammar point.
# LLM_PROVIDER=none | openai | anthropic
# If LLM_PROVIDER is unset, an API key turns that provider on.
# LLM_PROVIDER=none forces the built-in lessons even when a key is present.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Audio works without a key via Microsoft Edge neural voices.
# TTS_PROVIDER=edge | openai | voicevox
TTS_PROVIDER=edge
TTS_VOICE_JA=ja-JP-NanamiNeural
TTS_VOICE_EN=en-US-JennyNeural
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
# Used only when TTS_PROVIDER=voicevox. Speaker 2 is 四国めたん in a default VOICEVOX install.
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=2

# Optional subtitle search. The app is fully usable with uploaded files and no key.
JIMAKU_API_KEY=
